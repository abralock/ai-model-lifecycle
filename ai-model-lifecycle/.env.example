# Environment — copy to .env and fill in
# NEVER commit .env (it is gitignored)
OPENROUTER_TOKEN=sk-or-v1-REPLACE_ME

# OpenCode Go subscription (open-weight models, e.g. the glm-5.2-vs-5.3 and
# deepseek-v4.1-flash-vs-v4-pro pairs in models.yaml). Get the key at
# https://opencode.ai/console (subscribe to Go -> copy the API key).
OPENCODE_GO_API_KEY=REPLACE_ME

# Postgres container (used by R3/R4/R5 cases)
# 127.0.0.1 (not 'localhost') avoids the IPv6 ::1 resolution that can cause
# 'password authentication failed' on hosts where the container only binds IPv4.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aidb
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai
