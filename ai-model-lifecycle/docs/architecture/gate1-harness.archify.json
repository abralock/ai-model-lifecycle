  "cards": [
    {
      "dot": "cyan",
      "title": "One evaluation",
      "items": [
        "runner.py runs every case × {current, target} × N repeats under one UTC run id",
        "Each answer is saved raw; nothing is graded at call time",
        "report.py then re-scores every saved answer with the live scorers"
      ]
    },
    {
      "dot": "emerald",
      "title": "Time / Quality / Cost",
      "items": [
        "Quality: pass rate per model, Wilson CI, Fisher p between models",
        "Cost: OpenRouter billed cost, else pricing.py token prices",
        "Overall score is weighted with current = 100"
      ]
    },
    {
      "dot": "rose",
      "title": "Guard rails",
      "items": [
        "Claude Code route refuses to start unless logged in via claude.ai",
        "Both models of a pair share one provider; real-suite sources are SHA-256 locked",
        "Failures are reported only with verify_failures.py evidence"
      ]
    },
    {
      "dot": "slate",
      "title": "Optional",
      "items": [
        "mlflow_export.py copies runs and scores into MLflow; runs/ stays the source of truth",
        "--suite real swaps in whole codebases (r1b, r2) and writes REPORT.real.md"
      ]
    }
  ]
